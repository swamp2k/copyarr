{
  "data_dir": "/data",
  "listen_addr": ":8686",
  "rclone_config": "/config/rclone.conf",
  "scan_interval_seconds": 300,
  "rules": [
    {
      "id": "seedbox-to-unraid",
      "name": "Seedbox → Unraid downloads",
      "enabled": true,
      "source": { "remote": "seedbox", "path": "/media/sdm1/USER/private/rtorrent/complete" },
      "destination": { "remote": "", "path": "/downloads" },
      "mode": "copy",
      "initial_behavior": "ignore_existing",
      "stability_seconds": 600,
      "cleanup_days": 14,
      "verification": "size",
      "multi_thread_streams": 4,
      "multi_thread_cutoff": "256M",
      "retry_count": 3,
      "retry_wait_seconds": 300,
      "includes": [],
      "excludes": [],
      "rtorrent": {
        "url": "https://seedbox.example/RPC2",
        "username": "",
        "password": "",
        "view": "main",
        "source_base_path": "/media/sdm1/USER/private/rtorrent/complete",
        "required": false
      },
      "rclone_args": ["--retries", "5", "--low-level-retries", "10"]
    }
  ]
}
